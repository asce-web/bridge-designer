{
  "name": "tools",
  "version": "1.0.0",
  "description": "Bridge Designer CLI tool",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node esbuild.config.mjs",
    "postbuild": "chmod 755 dist/main.cjs",
    "start": "node dist/main.js"
  },
  "bin": {
    "bdc": "./dist/app/tools/src/main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gene-ressler/bridge-designer.git"
  },
  "keywords": [
    "bridgeDesigner",
    "cli"
  ],
